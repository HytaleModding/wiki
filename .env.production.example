# Production environment for the HytaleModding Wiki container.
# Copy to `.env.production` and fill in placeholder values.
#
#   cp .env.production.example .env.production
#   docker run --rm hytalemodding-wiki:latest php artisan key:generate --show
#

APP_NAME="HytaleModding Wiki"
VITE_APP_NAME="HytaleModding Wiki"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://wiki.hytalemodding.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log to stderr so output is captured by the container runtime.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# External database
DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=hytalemodding_wiki
DB_USERNAME=wiki
DB_PASSWORD=change-me

# Run `php artisan migrate --force` automatically on container start.
RUN_MIGRATIONS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Mail
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@hytalemodding.dev"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (only if you switch FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
